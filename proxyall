done
unset _pa_lib _pa_key
PA_FILES+=(proxyall)
PA_TARGETS+=("$PA_COMMAND")
PA_KEYS+=('')
PA_MARKERS+=("$PA_MARKER")
PA_CHANGED=()
PA_CREATED_DIRS=()
PA_COMMIT_CHANGED=0

pa_info() { printf '\n[proxyall] %s\n' "$*" >&2; }
pa_error() { printf '\n[错误] %s\n' "$*" >&2; }
pa_hash() { sha256sum -- "$1" | awk '{print $1}'; }

pa_help() {
    cat <<'EOF'
proxyall：Emby / Sing-box / Xray 统一管理

  proxyall                 打开菜单（首次运行下载并安装配套脚本）
  proxyall --install       安装或更新全部脚本，然后打开菜单
  proxyall --update        检查并询问是否更新全部脚本（可加 -v/--verbose 查看完整清单）
  proxyall --uninstall     卸载统一入口，保留服务及原有管理脚本
  proxyall --version       显示版本
  proxyall --fix-http2     备份并修复受管 Nginx 配置的 HTTP/2 旧语法
  proxyall --certificates  管理现有证书（查看、检查、续期、归档清理）
  proxyall --swap          配置 1 GiB swap（保留已有启用的 swap）

脚本更新不切换运行中的旧节点，也不迁移现有监听端口。
新建域名 HTTPS/443 反代默认使用 HAProxy；HTTP、自定义端口和 IP 前端使用直监听。
新建 Reality 默认端口 443、默认启用 SNI 分流。
共享入口要求 Linux + systemd，Emby 域名和 Reality SNI 必须不同。
请勿同时在其他终端用 sb / nginxproxy 修改同一份配置。
EOF
}

pa_fetch() {
    curl -q --proto '=https' --proto-redir '=https' --tlsv1.2 -fLsS --connect-timeout 10 --max-time 120 \
        --retry 2 --retry-delay 2 -H 'User-Agent: proxyall' "$1" -o "$2"
}

pa_dependencies() {
    local missing=0 cmd
    for cmd in curl sha256sum flock install mktemp tar gzip; do
        command -v "$cmd" >/dev/null 2>&1 || missing=1
    done
    [ "$missing" = 0 ] && return 0
    pa_info '安装下载与文件校验依赖...'
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y curl ca-certificates coreutils util-linux tar gzip || return 1
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y curl ca-certificates coreutils util-linux tar gzip || return 1
    elif command -v yum >/dev/null 2>&1; then
        yum install -y curl ca-certificates coreutils util-linux tar gzip || return 1
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache curl ca-certificates coreutils util-linux tar gzip || return 1
    else
        pa_error '请先安装 curl、ca-certificates、coreutils、util-linux、tar、gzip。'
        return 1
    fi
    for cmd in curl sha256sum flock install mktemp tar gzip; do command -v "$cmd" >/dev/null 2>&1 || return 1; done
}

pa_trusted_directory_chain() {
    local path="$1" depth="${2:-0}" owner mode link
    [ "$depth" -lt 40 ] || return 1
    while [ -n "$path" ]; do
        if [ -L "$path" ]; then
            owner=$(stat -c '%u' -- "$path") || return 1
            [[ "$owner" = 0 || "$owner" = "$EUID" ]] || return 1
            [ -d "$path" ] || return 1
            link=$(readlink -- "$path") || return 1
            [[ "$link" = /* ]] || link="$(dirname -- "$path")/$link"
            pa_trusted_directory_chain "$link" "$((depth + 1))" || return 1
        fi
        if [ -e "$path" ]; then
            [ -d "$path" ] || return 1
            read -r owner mode < <(stat -Lc '%u %a' -- "$path") || return 1
            [[ "$owner" = 0 || "$owner" = "$EUID" ]] || return 1
            [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
            (( (8#$mode & 0022) == 0 )) || return 1
        fi
        [ "$path" != / ] || break
        path=$(dirname -- "$path")
    done
}

pa_safe_directory() {
    local path="$1"
    [ ! -L "$path" ] || { pa_error "目录是符号链接，已停止: $path"; return 1; }
    if ! pa_trusted_directory_chain "$path"; then
        pa_error "目录路径或权限不安全，已停止: $path"
        return 1
    fi
}

pa_trusted_file() {
    local path="$1" owner mode
    [ ! -L "$path" ] && [ -f "$path" ] || return 1
    read -r owner mode < <(stat -c '%u %a' -- "$path") || return 1
    [[ "$owner" = 0 || "$owner" = "$EUID" ]] || return 1
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] && (( (8#$mode & 0022) == 0 ))
}

pa_safe_file_slot() {
    [ ! -L "$1" ] && { [ ! -e "$1" ] || pa_trusted_file "$1"; }
}

pa_prepare_state() {
    local file
    pa_safe_directory "$PA_STATE" || return 1
    if [ -d "$PA_STATE" ]; then
        if ! pa_trusted_file "$PA_STATE/.managed" || ! grep -Fqx "$PA_MARKER" "$PA_STATE/.managed"; then
            pa_error "$PA_STATE 已存在且不属于 proxyall，拒绝覆盖。"
            return 1
        fi
    else
        install -d -m 700 "$PA_STATE" || return 1
        (set -o noclobber; printf '%s\n' "$PA_MARKER" > "$PA_STATE/.managed") || return 1
    fi
    for file in commit manager.lock; do
        if ! pa_safe_file_slot "$PA_STATE/$file"; then
            pa_error "状态文件不安全，已停止: $PA_STATE/$file"
            return 1
        fi
    done
    exec 8<>"$PA_STATE/manager.lock" || return 1
    flock -n 8 || {
        exec 8>&-
        pa_error '已有一个 proxyall 会话或旧版后台进程持锁。请先退出另一个菜单。'
        pa_info "若没有其他菜单，请运行 fuser -v $PA_STATE/manager.lock 查看持锁进程；不要删除锁文件或直接杀服务。"
        return 1
    }
}

# 提取常量而不 source 下载文件。每个字段必须恰好出现一次。
pa_constant() {
    local file="$1" key="$2" assignment
    assignment=$(grep -E "^${key}=" "$file") || return 1
    [[ "$assignment" =~ ^${key}=\"([a-f0-9]{64})\"$ ]] || return 1
    printf '%s\n' "${BASH_REMATCH[1]}"
}

pa_version_of() {
    local file="$1" assignment
    assignment=$(grep -E '^PROXYALL_VERSION=' "$file") || return 1
    [[ "$assignment" =~ ^PROXYALL_VERSION=\"([A-Za-z0-9._-]+)\"$ ]] || return 1
    printf '%s\n' "${BASH_REMATCH[1]}"
}

pa_validate_bundle() {
    local dir="$1" file path key expected actual i
    pa_safe_directory "$dir" && pa_safe_directory "$dir/lib" || return 1
    pa_trusted_file "$dir/proxyall" || return 1
    for i in "${!PA_FILES[@]}"; do
        file=${PA_FILES[$i]}; path="$dir/$file"; key=${PA_KEYS[$i]}
        pa_trusted_file "$path" && grep -Fqx "${PA_MARKERS[$i]}" "$path" || return 1
        if LC_ALL=C grep -q $'\r' "$path"; then
            pa_error "$file 含有 CRLF，请在仓库中以 LF 保存。"
            return 1
        fi
        bash -n "$path" || return 1
        [ -n "$key" ] || continue
        expected=$(pa_constant "$dir/proxyall" "$key") || return 1
        actual=$(pa_hash "$path") || return 1
        [ "$actual" = "$expected" ] || { pa_error "$file 的 SHA-256 不匹配。"; return 1; }
    done
}

pa_libs_ready() {
    local i target key actual
    for i in "${!PA_FILES[@]}"; do
        [[ ${PA_FILES[$i]} = lib/* ]] || continue
        target=${PA_TARGETS[$i]}; key=${PA_KEYS[$i]}
        pa_safe_directory "${target%/*}" && pa_trusted_file "$target" &&
            grep -Fqx "${PA_MARKERS[$i]}" "$target" || return 1
        actual=$(pa_hash "$target") || return 1
        [ "$actual" = "${!key}" ] || return 1
    done
}

pa_local_bundle_verified() {
    local i file target key actual
    for i in "${!PA_FILES[@]}"; do
        file=${PA_FILES[$i]}; target=${PA_TARGETS[$i]}; key=${PA_KEYS[$i]}
        pa_safe_directory "${target%/*}" && pa_trusted_file "$target" &&
            grep -Fqx "${PA_MARKERS[$i]}" "$target" || return 1
        [[ "$file" = lib/* ]] || [ -x "$target" ] || return 1
        if [ -n "$key" ]; then
            actual=$(pa_hash "$target") || return 1
            [ "$actual" = "${!key}" ] || return 1
        else
            bash -n "$target" 2>/dev/null || return 1
            [ "$(pa_version_of "$target")" = "$PROXYALL_VERSION" ] || return 1
            if [ -f "${BASH_SOURCE[0]}" ]; then
                cmp -s "${BASH_SOURCE[0]}" "$target" || return 1
            fi
        fi
    done
}

pa_incomplete_notice() {
    pa_info '配套库缺失或版本不匹配。请在菜单选择 3) 检查脚本更新并输入 y，或运行 proxyall --update。'
}

pa_fetch_remote_commit() {
    local ref_file="${1:-$PA_STAGE/ref.json}" commit
    pa_fetch "https://api.github.com/repos/$PA_REPO/git/ref/heads/main" "$ref_file" && pa_trusted_file "$ref_file" || {
        pa_error '无法读取 GitHub 提交（也可能是 API 限流）。本地文件未改动。'
        return 1
    }
    commit=$(sed -n 's/.*"sha"[[:space:]]*:[[:space:]]*"\([a-f0-9]\{40\}\)".*/\1/p' "$ref_file")
    [[ "$commit" =~ ^[a-f0-9]{40}$ ]] || {
        pa_error 'GitHub 提交格式无效。'
        return 1
    }
    printf '%s\n' "$commit"
}

pa_extract_tarball() {
    local archive="$1" dest="$2"
    local list vlist entry vline top root="" type clean_path file member extract_dir i
    local -a entries=() vlines=() members=()
    local -A required=() seen=()

    list=$(LC_ALL=C tar -tzf "$archive" 2>/dev/null) || return 1
    vlist=$(LC_ALL=C tar -tvzf "$archive" 2>/dev/null) || return 1
    [ -n "$list" ] || return 1

    mapfile -t entries <<< "$list"
    mapfile -t vlines <<< "$vlist"
    [ "${#entries[@]}" -gt 0 ] && [ "${#entries[@]}" -eq "${#vlines[@]}" ] || return 1

    for i in "${!entries[@]}"; do
        entry=${entries[$i]}
        [ -n "$entry" ] || return 1
        [[ "$entry" != /* ]] || return 1
        [[ "/$entry/" != */../* ]] || return 1
        [[ "/$entry/" != */./* ]] || return 1
        [[ "$entry" != *//* ]] || return 1
        if [ "$entry" = pax_global_header ]; then
            continue
        fi
        top=${entry%%/*}
        if [[ ! "$top" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            return 1
        fi
        if [ -z "$root" ]; then
            root="$top"
        elif [ "$top" != "$root" ]; then
            return 1
        fi
    done
    [ -n "$root" ] || return 1

    for file in "${PA_FILES[@]}"; do
        required["$root/$file"]=1
    done

    for i in "${!entries[@]}"; do
        entry=${entries[$i]}
        vline=${vlines[$i]}
        [ "$entry" != pax_global_header ] || continue
        type=${vline:0:1}
        clean_path=${entry%/}
        if [ "$clean_path" = "$root" ] || [ "$clean_path" = "$root/lib" ]; then
            [ "$type" = d ] || return 1
        fi
        if [ -n "${required[$clean_path]:-}" ]; then
            [ "$entry" = "$clean_path" ] || return 1
            [[ "$vline" =~ ^-[rwxstST-]{9}[.+]?[[:space:]]+.*[[:space:]][0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+[0-9]{2}:[0-9]{2}(:[0-9]{2})?[[:space:]]+(.+)$ ]] || return 1
            [ "${BASH_REMATCH[2]}" = "$entry" ] || return 1
            [[ "$vline" != *' -> '* ]] && [[ "$vline" != *' link to '* ]] || return 1
            seen["$clean_path"]=$(( ${seen[$clean_path]:-0} + 1 ))
            [ "${seen[$clean_path]}" -eq 1 ] || return 1
        fi
    done

    for file in "${PA_FILES[@]}"; do
        member="$root/$file"
        [ "${seen[$member]:-0}" -eq 1 ] || return 1
        members+=("$member")
    done

    extract_dir="$dest/extract"
    mkdir -m 700 -- "$extract_dir" || return 1
    if ! tar -xzf "$archive" -C "$extract_dir" "${members[@]}" 2>/dev/null; then
        rm -rf -- "$extract_dir"
        return 1
    fi
    if [ -L "$extract_dir/$root" ] || [ ! -d "$extract_dir/$root" ] ||
       [ -L "$extract_dir/$root/lib" ] || [ ! -d "$extract_dir/$root/lib" ]; then
        rm -rf -- "$extract_dir"
        return 1
    fi
    if [ ! -d "$dest/lib" ]; then
        mkdir -m 700 -- "$dest/lib" || { rm -rf -- "$extract_dir"; return 1; }
    elif [ -L "$dest/lib" ]; then
        rm -rf -- "$extract_dir"
        return 1
    fi
    for file in "${PA_FILES[@]}"; do
        if [ -L "$extract_dir/$root/$file" ] || [ ! -f "$extract_dir/$root/$file" ] ||
           [ "$(stat -c '%h' -- "$extract_dir/$root/$file")" != 1 ] ||
           ! cp -- "$extract_dir/$root/$file" "$dest/$file" ||
           ! chmod 600 -- "$dest/$file"; then
            rm -rf -- "$extract_dir"
            return 1
        fi
    done
    rm -rf -- "$extract_dir" "$archive"
}

pa_download_bundle() {
    local commit="${1:-}" archive file raw
    [ -n "$PA_STAGE" ] || PA_STAGE=$(mktemp -d "$PA_STATE/stage.XXXXXXXX") || return 1
    [ -n "$commit" ] || commit=$(pa_fetch_remote_commit "$PA_STAGE/ref.json") || return 1
    archive="$PA_STAGE/bundle.tar.gz"
    pa_info "正在下载提交 ${commit:0:7} 的整套脚本..."
    if pa_fetch "https://codeload.github.com/$PA_REPO/tar.gz/$commit" "$archive" && pa_trusted_file "$archive"; then
        if ! pa_extract_tarball "$archive" "$PA_STAGE"; then
            pa_error '源码归档校验或解压失败，本地文件未改动。'
            return 1
        fi
    else
        rm -f -- "$archive"
        pa_info '归档下载失败，回退至逐文件下载...'
        raw="https://raw.githubusercontent.com/$PA_REPO/$commit"
        [ -d "$PA_STAGE/lib" ] || mkdir -m 700 -- "$PA_STAGE/lib" || return 1
        for file in "${PA_FILES[@]}"; do
            pa_fetch "$raw/$file" "$PA_STAGE/$file" || { pa_error "下载失败: $file"; return 1; }
        done
    fi
    pa_validate_bundle "$PA_STAGE" || { pa_error '整套脚本校验失败，本地文件未改动。'; return 1; }
    printf '%s\n' "$commit" > "$PA_STAGE/commit"
}

pa_legacy_component() {
    local target="$1" file="$2" name
    local -a functions
    # 只静态识别旧脚本，不 source / 执行 VPS 上待接管的文件。
    bash -n "$target" 2>/dev/null || return 1
    if [ "$file" = deploy.sh ]; then
        grep -Eq "^BACKUP_DIR=[\"']?/etc/nginx/backup[\"']?[[:space:]]*$" "$target" || return 1
    else
        grep -Eq "^SINGBOX_DIR=[\"']?/usr/local/etc/sing-box[\"']?[[:space:]]*$" "$target" || return 1
    fi
    case "$file" in
        sb.sh) functions=(_check_root _install_sing_box _add_vless_reality _update_script _main_menu) ;;
        deploy.sh) functions=(show_help parse_arguments install_dependencies issue_certificate generate_nginx_config main) ;;
        *) return 1 ;;
    esac
    for name in "${functions[@]}"; do
        grep -Eq "^[[:space:]]*(function[[:space:]]+)?${name}[[:space:]]*\\([[:space:]]*\\)[[:space:]]*\\{" "$target" || return 1
    done
}

pa_known_target() {
    local target="$1" file="$2"
    pa_safe_file_slot "$target" || return 1
    [ -e "$target" ] || return 0
    case "$file" in
        sb.sh) grep -Fqx '# SB_MANAGER_MANAGED_COMMAND=1' "$target" || pa_legacy_component "$target" "$file" ;;
        deploy.sh) grep -Fqx '# NGINXPROXY_MANAGED_COMMAND=1' "$target" || pa_legacy_component "$target" "$file" ;;
        proxyall) grep -Fqx "$PA_MARKER" "$target" ;;
        lib/*) grep -Fqx "# PROXYALL_LIB=${file##*/}" "$target" ;;
    esac
}

pa_atomic_install() (
    local source="$1" target="$2" mode="${3:-700}" tmp=""
    trap '[ -z "$tmp" ] || rm -f -- "$tmp"' EXIT
    tmp=$(mktemp "${target}.proxyall.XXXXXXXX") || return 1
    if [ "$mode" = preserve ]; then
        cp -p -- "$source" "$tmp" || return 1
    else
        install -m "$mode" -- "$source" "$tmp" || return 1
    fi
    mv -fT -- "$tmp" "$target" || return 1
    tmp=""
)

pa_restore_target() {
    local backup="$1" target="$2"
    if [ -f "$backup" ]; then
        pa_atomic_install "$backup" "$target" preserve
    else
        rm -f -- "$target"
    fi
}

pa_rollback() {
    local j i failed=0
    [ "$PA_TRANSACTION" = 1 ] || return 0
    pa_error '安装未完成，正在恢复安装前的脚本和提交记录...'
    if [ "$PA_COMMIT_CHANGED" = 1 ]; then
        pa_restore_target "$PA_BACKUP/commit" "$PA_STATE/commit" || failed=1
    fi
    for ((j=${#PA_CHANGED[@]} - 1; j >= 0; j--)); do
        i=${PA_CHANGED[$j]}
        pa_restore_target "$PA_BACKUP/${PA_FILES[$i]}" "${PA_TARGETS[$i]}" || failed=1
    done
    for ((j=${#PA_CREATED_DIRS[@]} - 1; j >= 0; j--)); do
        rmdir -- "${PA_CREATED_DIRS[$j]}" 2>/dev/null || true
    done
    PA_TRANSACTION=0
    [ "$failed" = 0 ] || pa_error "部分文件恢复失败，原文件备份保留在 $PA_BACKUP"
    return "$failed"
}

pa_cleanup() {
    pa_rollback || true
    # 仅清理自己通过 mktemp 创建的下载目录，不删除业务或备份目录。
    if [[ "$PA_STAGE" == "$PA_STATE"/stage.* ]] && [ -d "$PA_STAGE" ]; then
        rm -rf -- "$PA_STAGE"
    fi
    PA_STAGE=""
}

pa_check_targets() {
    local i target
    pa_safe_file_slot "$PA_STATE/commit" || return 1
    for i in "${!PA_FILES[@]}"; do
        target=${PA_TARGETS[$i]}
        pa_safe_directory "${target%/*}" || return 1
        pa_known_target "$target" "${PA_FILES[$i]}" || {
            pa_error "路径已被无法识别或权限不安全的文件占用，已保留: $target"; return 1;
        }
    done
}

pa_make_target_directory() {
    local dir="$1"
    [ ! -d "$dir" ] || return 0
    pa_make_target_directory "${dir%/*}" || return 1
    PA_CREATED_DIRS+=("$dir")
    mkdir -- "$dir"
}

pa_publish_backup() {
    local backup old_backup
    # 自动维护只保留最新的 backup.*。仅在更新成功且安装前的
    # 快照确实完整时才发布它，避免清理任务删除唯一可用的旧版。
    pa_validate_bundle "$PA_BACKUP" >/dev/null 2>&1 || return 0
    backup="$PA_STATE/backup.${PA_BACKUP##*.}"
    if [ -e "$backup" ] || [ -L "$backup" ] || ! mv -T -- "$PA_BACKUP" "$backup"; then
        pa_error "无法发布备份，原文件仍保留在 $PA_BACKUP"
        return 0
    fi
    PA_BACKUP="$backup"
    for old_backup in "$PA_STATE"/backup.*; do
        [ "$old_backup" != "$PA_BACKUP" ] && [ -d "$old_backup" ] || continue
        pa_safe_directory "$old_backup" || continue
        rm -rf -- "$old_backup" || pa_error "无法清理旧备份: $old_backup"
    done
}

pa_install_bundle() {
    local i target file mode
    pa_check_targets || return 1
    PA_BACKUP=$(mktemp -d "$PA_STATE/rollback.XXXXXXXX") || return 1
    mkdir -m 700 -- "$PA_BACKUP/lib" || return 1
    for i in "${!PA_FILES[@]}"; do
        target=${PA_TARGETS[$i]}
        if [ -e "$target" ]; then cp -p -- "$target" "$PA_BACKUP/${PA_FILES[$i]}" || return 1; fi
    done
    if [ -e "$PA_STATE/commit" ]; then cp -p -- "$PA_STATE/commit" "$PA_BACKUP/commit" || return 1; fi
    PA_CHANGED=()
    PA_CREATED_DIRS=()
    PA_COMMIT_CHANGED=0
    PA_TRANSACTION=1
    for i in "${!PA_FILES[@]}"; do
        target=${PA_TARGETS[$i]}; file=${PA_FILES[$i]}
        pa_make_target_directory "${target%/*}" || return 1
        mode=700
        [[ "$file" != lib/* ]] || mode=644
        PA_CHANGED+=("$i")
        pa_atomic_install "$PA_STAGE/$file" "$target" "$mode" || return 1
    done
    PROXYALL_MANAGED=1 bash "${PA_TARGETS[0]}" setup-maintenance 8>&- || {
        pa_error '自动日志维护设置失败，已停止更新；请检查错误后重试。'
        return 1
    }
    PA_COMMIT_CHANGED=1
    pa_atomic_install "$PA_STAGE/commit" "$PA_STATE/commit" 600 || return 1
    PA_TRANSACTION=0
    pa_publish_backup
    pa_info "脚本已配套安装。旧脚本备份: $PA_BACKUP"
    pa_info '现有节点、证书、Nginx 和 HAProxy 配置均保留。以后输入 proxyall 即可打开。'
}

pa_print_status_table() {
    local table_mode="${1:-all_current}" i
    shift || true
    local -a statuses=("$@")
    printf '\n  文件                   状态\n'
    for i in "${!PA_FILES[@]}"; do
        if [ "$table_mode" = all_current ] || [ "${statuses[$i]:-}" = unchanged ]; then
            printf '  %-22s 已是仓库版本\n' "${PA_FILES[$i]}"
        else
            printf '  %-22s 待安装 / 有变化\n' "${PA_FILES[$i]}"
        fi
    done
}

pa_update() {
    local mode="${1:-ask}" verbose="${2:-0}" i file commit local_commit="" local_short remote_ver answer
    local changed=0 changed_bins=0 changed_libs=0
    local -a file_status=() changed_files=()
    pa_check_targets || return 1
    PA_STAGE=$(mktemp -d "$PA_STATE/stage.XXXXXXXX") || return 1
    commit=$(pa_fetch_remote_commit "$PA_STAGE/ref.json") || { pa_cleanup; return 1; }
    if [ -f "$PA_STATE/commit" ]; then
        IFS= read -r local_commit < "$PA_STATE/commit" || true
    fi
    if [ "$mode" != install ] && [ -n "$local_commit" ] && [ "$local_commit" = "$commit" ] && pa_local_bundle_verified; then
        if [ "$verbose" = 1 ]; then
            pa_print_status_table all_current
        else
            pa_info "已是最新版本 v$PROXYALL_VERSION (${commit:0:7})，共 ${#PA_FILES[@]} 个文件均完整。"
        fi
        pa_cleanup
        return 0
    fi
    pa_download_bundle "$commit" || { pa_cleanup; return 1; }
    for i in "${!PA_FILES[@]}"; do
        file=${PA_FILES[$i]}
        if { [[ "$file" = lib/* ]] || [ -x "${PA_TARGETS[$i]}" ]; } &&
            cmp -s "$PA_STAGE/$file" "${PA_TARGETS[$i]}"; then
            file_status+=(unchanged)
        else
            file_status+=(changed)
            changed=$((changed + 1))
            changed_files+=("$file")
            if [[ "$file" = lib/* ]]; then
                changed_libs=$((changed_libs + 1))
            else
                changed_bins=$((changed_bins + 1))
            fi
        fi
    done
    remote_ver=$(pa_version_of "$PA_STAGE/proxyall") || remote_ver="未知"
    if [ "$changed" = 0 ]; then
        pa_atomic_install "$PA_STAGE/commit" "$PA_STATE/commit" 600 || { pa_cleanup; return 1; }
        if [ "$verbose" = 1 ]; then
            pa_print_status_table all_current
        else
            pa_info "已是最新脚本 v${remote_ver} (${commit:0:7})，${#PA_FILES[@]} 个文件无变化（已同步提交记录）。"
        fi
        pa_cleanup
        return 0
    fi
    if [ "$verbose" = 1 ]; then
        pa_print_status_table diff "${file_status[@]}"
    elif [ "$mode" = install ]; then
        pa_info "准备安装 v${remote_ver} (${commit:0:7})，共 ${#PA_FILES[@]} 个文件（已通过 SHA-256 校验）。"
    else
        if [[ "$local_commit" =~ ^[a-f0-9]{40}$ ]]; then
            local_short="${local_commit:0:7}"
        else
            local_short="未知"
        fi
        pa_info "发现更新: v${PROXYALL_VERSION} (${local_short}) -> v${remote_ver} (${commit:0:7})，共 ${changed}/${#PA_FILES[@]} 个文件有变化"
        if [ "$changed" -le 8 ]; then
            for file in "${changed_files[@]}"; do
                printf '  - %s\n' "$file"
            done
        else
            printf '  包含入口脚本 %d 个、配套库 %d 个（运行 proxyall --update --verbose 查看完整清单）\n' "$changed_bins" "$changed_libs"
        fi
    fi
    if [ "$mode" != install ]; then
        read -r -p '是否备份并统一更新上述脚本？[y/N]: ' answer || { pa_cleanup; return 1; }
        [[ "$answer" =~ ^[Yy]$ ]] || { pa_cleanup; return 0; }
    fi
    if ! pa_install_bundle; then pa_cleanup; return 1; fi
    pa_cleanup
    # 当前 shell 仍持有旧菜单代码，更新后重新加载，并释放会话锁。
    exec 8>&-
    exec bash "$PA_COMMAND"
}

pa_uninstall() {
    local answer
    pa_info '只卸载 proxyall 入口；保留 sb、nginxproxy、组件、备份以及全部运行服务。'
    read -r -p '输入 UNINSTALL 确认，其他输入返回: ' answer || return 1
    [ "$answer" = UNINSTALL ] || return 0
    if ! pa_safe_directory "${PA_COMMAND%/*}" || ! pa_known_target "$PA_COMMAND" proxyall; then
        pa_error '入口文件不属于 proxyall，已保留。'; return 1
    fi
    rm -f -- "$PA_COMMAND" || return 1
    pa_info 'proxyall 入口已卸载。现有服务继续运行，可用 sb / nginxproxy 管理。'
    exit 0
}

pa_run() {
    local component="$1" status=0
    pa_libs_ready || { pa_incomplete_notice; return 1; }
    pa_safe_directory "${component%/*}" && pa_trusted_file "$component" && bash -n "$component" || {
        pa_error '组件缺失、不安全或语法损坏，请先检查脚本更新。'; return 1;
    }
    # 必须作为子进程运行，避免 deploy 的 errexit/trap/变量污染统一菜单。
    # 只有菜单持锁；子脚本启动的后台服务不能继承这个文件描述符。
    shift
    PROXYALL_MANAGED=1 bash "$component" "$@" 8>&- || status=$?
    [ "$status" = 0 ] || pa_error "子脚本返回状态 $status，已返回统一菜单。"
    return "$status"
}

pa_setup_swap() (
    local swap_file="${1:-/swapfile.proxyall}" fstab="${2:-/etc/fstab}"
    local swaps="${3:-/proc/swaps}" cmd available candidate="" backup=""
    local created=0 active=0 committed=0
    umask 077
    for cmd in dd mkswap swapon swapoff df awk cp cmp mktemp mv chmod; do
        command -v "$cmd" >/dev/null 2>&1 || {
            pa_error "缺少命令 $cmd，请安装 coreutils 和 util-linux。"; return 1;
        }
    done
    [ -r "$swaps" ] || { pa_error '无法读取系统 swap 状态。'; return 1; }
    if awk 'NR > 1 { found=1 } END { exit !found }' "$swaps"; then
        pa_info '系统已有启用的 swap，保持现有配置。'
        return 0
    fi
    if [ -e "$swap_file" ] || [ -L "$swap_file" ]; then
        pa_error "$swap_file 已存在，拒绝覆盖。"; return 1
    fi
    [ -f "$fstab" ] && [ ! -L "$fstab" ] || {
        pa_error 'fstab 不是普通文件，无法配置开机挂载。'; return 1;
    }
    if awk -v path="$swap_file" '$1 == path { found=1 } END { exit !found }' "$fstab"; then
        pa_error 'fstab 已包含该 swap 路径，请先检查现有配置。'; return 1
    fi
    available=$(df -Pk -- "$(dirname -- "$swap_file")" | awk 'NR == 2 {print $4}')
    if ! [[ "$available" =~ ^[0-9]+$ ]] || [ "$available" -lt 1179648 ]; then
        pa_error '磁盘可用空间不足，需要至少 1152 MiB。'; return 1
    fi
    cleanup_swap() {
        local status=$?
        [ -z "$candidate" ] || rm -f -- "$candidate"
        if [ "$created" = 1 ] && [ "$committed" = 0 ]; then
            if [ "$active" = 0 ] || swapoff "$swap_file"; then
                rm -f -- "$swap_file"
            else
                pa_error "无法停用 $swap_file，文件已保留；请检查 swap 状态和开机挂载配置。"
            fi
        fi
        return "$status"
    }
    trap cleanup_swap EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    backup=$(mktemp "${fstab}.proxyall-backup.$(date +%Y%m%d%H%M%S).XXXXXX") || return 1
    cp -p -- "$fstab" "$backup" || return 1
    cmp -s -- "$fstab" "$backup" || return 1
    candidate=$(mktemp "${fstab}.proxyall.XXXXXX") || return 1
    cp -p -- "$backup" "$candidate" || return 1
    printf '\n%s none swap sw 0 0\n' "$swap_file" >> "$candidate" || return 1
    (set -o noclobber; : > "$swap_file") || return 1
    created=1
    chmod 600 "$swap_file" || return 1
    pa_info '正在创建 1 GiB swap...'
    if ! dd if=/dev/zero of="$swap_file" bs=1M count=1024 conv=notrunc status=none ||
       ! mkswap "$swap_file"; then
        pa_error 'swap 文件创建失败。'; return 1
    fi
    if ! swapon "$swap_file"; then
        pa_error '无法启用 swap，请检查虚拟化权限和文件系统是否支持 swap 文件。'; return 1
    fi
    active=1
    if ! cmp -s -- "$fstab" "$backup"; then
        pa_error 'fstab 在操作期间发生变化，请重试。'; return 1
    fi
    mv -f -- "$candidate" "$fstab" || return 1
    committed=1
    pa_info "1 GiB swap 已启用并配置开机挂载：$swap_file"
    pa_info "fstab 备份：$backup"
)

pa_menu() {
    local choice prompt
    while true; do
        printf '\n  ════════════════════════════════════\n'
        printf '       proxyall  %s\n\n' "$PROXYALL_VERSION"
        if pa_libs_ready; then
            printf '  1) Emby / 本机服务反代\n'
            printf '  2) Sing-box / Xray 节点、分享链接与中转\n\n'
            prompt='0-7'
        else
            pa_incomplete_notice
            prompt='0/3/4/7'
        fi
        printf '  3) 检查脚本更新\n'
        printf '  4) 卸载统一入口（保留全部服务）\n'
        if [ "$prompt" = '0-7' ]; then
            printf '  5) 修复 Nginx HTTP/2 旧语法\n'
            printf '  6) 证书管理\n'
        fi
        printf '  7) 配置 1 GiB swap\n\n'
        printf '  0) 退出脚本\n'
        printf '  ════════════════════════════════════\n'
        read -r -p "  请选择 [$prompt]: " choice || return 0
        case "$choice" in
            1) pa_run "${PA_TARGETS[1]}" || true ;;
            2) pa_run "${PA_TARGETS[0]}" || true ;;
            3) pa_update || true ;;
            4) pa_uninstall || true ;;
            5) pa_run "${PA_TARGETS[1]}" --fix-http2 || true ;;
            6) pa_run "${PA_TARGETS[1]}" --certificates || true ;;
            7) pa_setup_swap || true ;;
            0) return 0 ;;
            *) pa_error '请输入 0-7。' ;;
        esac
    done
}

main() {
    local action="${1:-}" verbose=0
    if [ "$action" = --update ] && [ "$#" -eq 2 ] && { [ "$2" = --verbose ] || [ "$2" = -v ]; }; then
        verbose=1
    elif [ "$#" -gt 1 ]; then
        pa_error '参数过多，请只指定一个操作。'
        pa_help >&2
        return 2
    fi
    case "$action" in
        --version) printf '%s\n' "$PROXYALL_VERSION"; return 0 ;;
        -h|--help) pa_help; return 0 ;;
        ''|--install|--update|--uninstall|--fix-http2|--certificates|--swap) ;;
        *) pa_help; return 2 ;;
    esac
    [ "$EUID" = 0 ] || { pa_error '请用 root 或 sudo -H bash proxyall 运行。'; return 1; }
    [ "$(uname -s)" = Linux ] || { pa_error '此脚本用于 Linux VPS。'; return 1; }
    # 查看证书无需安装下载依赖；续期和归档由 nginxproxy 持配置写锁并复核证书引用。
    if [ "$action" = --certificates ]; then
        pa_run "${PA_TARGETS[1]}" --certificates
        return $?
    fi
    pa_dependencies || return 1
    pa_prepare_state || return 1
    trap 'pa_cleanup; exec 8>&-' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    case "$action" in
        --swap) pa_setup_swap; return $? ;;
        --install) pa_update install || return 1; pa_menu; return $? ;;
        --update) pa_update ask "$verbose"; return $? ;;
        --uninstall) pa_uninstall; return $? ;;
        --fix-http2) pa_run "${PA_TARGETS[1]}" --fix-http2; return $? ;;
    esac
    # 三文件旧版更新已经写入 commit；库缺失时保留菜单中的显式更新入口。
    if [ ! -e "$PA_COMMAND" ] && [ ! -L "$PA_COMMAND" ]; then
        pa_update install || return 1
    fi
    if [ ! -d /run/systemd/system ]; then
        pa_info '当前无 systemd：可查看已有配置；HAProxy 共享 443 功能无法部署。'
    fi
    pa_info '新建默认共享 443；已有直监听节点保持原样。Emby 域名须与 Reality SNI 不同。'
    pa_menu
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
