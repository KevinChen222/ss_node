#!/usr/bin/env bash
# PROXYALL_MANAGED_COMMAND=1
# 配套发布时先更新 parser -> advanced_relay -> sb 的哈希，再更新以下四个值。
PROXYALL_VERSION="1.0.1"
SB_SHA256="59bbdd2fb7d11254b269138c03d48ff1b049899e7fd0d70a87913a481c61dc68"
DEPLOY_SHA256="2bdc55c019bd3a649813b83b010aee1e06f8c1319ccb532e2423ed265c9153c8"
RELAY_SHA256="39083485d7e4ab178e6dbf9cca9f11692fe9980f5ac94c5162531bd8ee1e85a1"
PARSER_SHA256="b027bee53ca0809bb075c9467ecb1bfe0f8775b8dfb57e22a73f959d85210805"

umask 077
set -o pipefail
PA_REPO="KevinChen222/ss_node"
PA_STATE="/var/lib/proxyall"
PA_COMMAND="/usr/local/bin/proxyall"
PA_MARKER="# PROXYALL_MANAGED_COMMAND=1"
PA_STAGE=""
PA_BACKUP=""
PA_TRANSACTION=0
PA_FILES=(sb.sh deploy.sh advanced_relay.sh parser.sh proxyall)
PA_TARGETS=(/usr/local/bin/sb /usr/local/bin/nginxproxy
    /usr/local/etc/sing-box/advanced_relay.sh /usr/local/etc/sing-box/parser.sh
    /usr/local/bin/proxyall)
PA_CHANGED=()

pa_info() { printf '\n[proxyall] %s\n' "$*" >&2; }
pa_error() { printf '\n[错误] %s\n' "$*" >&2; }
pa_hash() { sha256sum -- "$1" | awk '{print $1}'; }

pa_help() {
    cat <<'EOF'
proxyall：Emby / sing-box 统一管理

  proxyall                 打开菜单（首次运行下载并安装配套脚本）
  proxyall --install       安装或更新全部脚本，然后打开菜单
  proxyall --update        检查并询问是否更新全部脚本
  proxyall --uninstall     卸载统一入口，保留服务及原有管理脚本
  proxyall --version       显示版本

脚本更新不升级 sing-box 核心，也不迁移现有监听端口。
新建 Emby 默认使用 HAProxy；新建 Reality 默认端口 443、默认启用 SNI 分流。
共享入口要求 Linux + systemd，Emby 域名和 Reality SNI 必须不同。
请勿同时在其他终端用 sb / nginxproxy 修改同一份配置。
EOF
}

pa_fetch() {
    curl --proto '=https' --tlsv1.2 -fLsS --connect-timeout 10 --max-time 120 \
        --retry 2 --retry-delay 2 -H 'User-Agent: proxyall' "$1" -o "$2"
}

pa_dependencies() {
    local missing=0 cmd
    for cmd in curl sha256sum flock install mktemp; do
        command -v "$cmd" >/dev/null 2>&1 || missing=1
    done
    [ "$missing" = 0 ] && return 0
    pa_info '安装下载与文件校验依赖...'
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y curl ca-certificates coreutils util-linux || return 1
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y curl ca-certificates coreutils util-linux || return 1
    elif command -v yum >/dev/null 2>&1; then
        yum install -y curl ca-certificates coreutils util-linux || return 1
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache curl ca-certificates coreutils util-linux || return 1
    else
        pa_error '请先安装 curl、ca-certificates、coreutils、util-linux。'
        return 1
    fi
    for cmd in curl sha256sum flock install mktemp; do command -v "$cmd" >/dev/null 2>&1 || return 1; done
}

pa_safe_directory() {
    local path="$1" parent="$1"
    while [ "$parent" != / ] && [ -n "$parent" ]; do
        [ ! -L "$parent" ] || { pa_error "目录是符号链接，已停止: $parent"; return 1; }
        parent=$(dirname -- "$parent")
    done
    [ ! -e "$path" ] || [ -d "$path" ]
}

pa_prepare_state() {
    pa_safe_directory "$PA_STATE" || return 1
    if [ -e "$PA_STATE" ] && ! grep -Fqx "$PA_MARKER" "$PA_STATE/.managed" 2>/dev/null; then
        pa_error "$PA_STATE 已存在且不属于 proxyall，拒绝覆盖。"
        return 1
    fi
    install -d -m 700 "$PA_STATE" || return 1
    printf '%s\n' "$PA_MARKER" > "$PA_STATE/.managed" || return 1
    exec 8>"$PA_STATE/manager.lock" || return 1
    flock -n 8 || { pa_error '已有一个 proxyall 会话，请先退出另一个菜单。'; return 1; }
}

# 提取常量而不 source 下载文件。每个字段必须恰好出现一次。
pa_constant() {
    local file="$1" key="$2" value
    value=$(sed -n "s/^${key}=\"\([a-f0-9]\{64\}\)\"$/\1/p" "$file")
    [[ "$value" =~ ^[a-f0-9]{64}$ ]] || return 1
    printf '%s\n' "$value"
}

pa_validate_bundle() {
    local dir="$1" file key expected actual i
    local keys=(SB_SHA256 DEPLOY_SHA256 RELAY_SHA256 PARSER_SHA256)
    grep -Fqx "$PA_MARKER" "$dir/proxyall" || return 1
    grep -Fqx '# SB_MANAGER_MANAGED_COMMAND=1' "$dir/sb.sh" || return 1
    grep -Fqx '# NGINXPROXY_MANAGED_COMMAND=1' "$dir/deploy.sh" || return 1
    for file in "${PA_FILES[@]}"; do
        [ -s "$dir/$file" ] && bash -n "$dir/$file" || return 1
        if LC_ALL=C grep -q $'\r' "$dir/$file"; then
            pa_error "$file 含有 CRLF，请在仓库中以 LF 保存。"
            return 1
        fi
    done
    for i in 0 1 2 3; do
        file=${PA_FILES[$i]}; key=${keys[$i]}
        expected=$(pa_constant "$dir/proxyall" "$key") || return 1
        actual=$(pa_hash "$dir/$file") || return 1
        [ "$actual" = "$expected" ] || { pa_error "$file 的 SHA-256 不匹配。"; return 1; }
    done
    [ "$(pa_constant "$dir/sb.sh" ADVANCED_RELAY_SHA256)" = "$(pa_hash "$dir/advanced_relay.sh")" ] || return 1
    for file in sb.sh advanced_relay.sh; do
        [ "$(pa_constant "$dir/$file" PARSER_SHA256)" = "$(pa_hash "$dir/parser.sh")" ] || return 1
    done
}

pa_download_bundle() {
    local ref_file commit file raw
    PA_STAGE=$(mktemp -d "$PA_STATE/stage.XXXXXXXX") || return 1
    ref_file="$PA_STAGE/ref.json"
    pa_info '查询仓库 main 的提交，下载同一提交的五个脚本...'
    pa_fetch "https://api.github.com/repos/$PA_REPO/git/ref/heads/main" "$ref_file" || {
        pa_error '无法读取 GitHub 提交（也可能是 API 限流）。本地文件未改动。'; return 1;
    }
    commit=$(sed -n 's/.*"sha"[[:space:]]*:[[:space:]]*"\([a-f0-9]\{40\}\)".*/\1/p' "$ref_file")
    [[ "$commit" =~ ^[a-f0-9]{40}$ ]] || { pa_error 'GitHub 提交格式无效。'; return 1; }
    raw="https://raw.githubusercontent.com/$PA_REPO/$commit"
    for file in "${PA_FILES[@]}"; do
        pa_fetch "$raw/$file" "$PA_STAGE/$file" || { pa_error "下载失败: $file"; return 1; }
    done
    pa_validate_bundle "$PA_STAGE" || { pa_error '整套脚本校验失败，本地文件未改动。请确保五个文件配套上传。'; return 1; }
    printf '%s\n' "$commit" > "$PA_STAGE/commit"
}

pa_legacy_component() {
    local target="$1" file="$2" name
    local -a functions
    # 只静态识别旧脚本，不 source / 执行 VPS 上待接管的文件。
    bash -n "$target" 2>/dev/null || return 1
    grep -Eq "^SINGBOX_DIR=[\"']?/usr/local/etc/sing-box[\"']?[[:space:]]*$" "$target" || return 1
    case "$file" in
        advanced_relay.sh) functions=(_check_deps _init_relay_dirs _landing_config _relay_config _menu) ;;
        parser.sh) functions=(_url_decode _get_param _parse_vless _parse_vmess _parse_trojan _parse_ss) ;;
        *) return 1 ;;
    esac
    for name in "${functions[@]}"; do
        grep -Eq "^[[:space:]]*(function[[:space:]]+)?${name}[[:space:]]*\\([[:space:]]*\\)[[:space:]]*\\{" "$target" || return 1
    done
}

pa_known_target() {
    local target="$1" file="$2" actual
    [ ! -L "$target" ] || return 1
    [ -e "$target" ] || return 0
    [ -f "$target" ] || return 1
    case "$file" in
        sb.sh) grep -Fqx '# SB_MANAGER_MANAGED_COMMAND=1' "$target" ;;
        deploy.sh) grep -Fqx '# NGINXPROXY_MANAGED_COMMAND=1' "$target" ;;
        proxyall) grep -Fqx "$PA_MARKER" "$target" ;;
        advanced_relay.sh|parser.sh)
            if grep -Fqx "# PROXYALL_COMPONENT=$file" "$target"; then return 0; fi
            actual=$(pa_hash "$target") || return 1
            # 已知原版哈希用于快速识别；其他旧版按目录与多项函数特征识别。
            case "$file:$actual" in
                advanced_relay.sh:c729615d6ee272c2b1fb74e1c5753416d2237e2e18ebfc7fa6c3bc826992ccbc|parser.sh:33edfbb4dc2dd2724d950b0608ae3c910db859f21701fd0e9ec8e09c2d438f31) return 0 ;;
            esac
            pa_legacy_component "$target" "$file"
            ;;
    esac
}

pa_atomic_install() {
    local source="$1" target="$2" tmp
    tmp=$(mktemp "${target}.proxyall.XXXXXXXX") || return 1
    if ! install -m 700 -- "$source" "$tmp" || ! mv -f -- "$tmp" "$target"; then
        rm -f -- "$tmp"
        return 1
    fi
}

pa_rollback() {
    local i target failed=0
    [ "$PA_TRANSACTION" = 1 ] || return 0
    pa_error '安装未完成，正在恢复安装前的脚本文件...'
    for i in "${PA_CHANGED[@]}"; do
        target=${PA_TARGETS[$i]}
        if [ -f "$PA_BACKUP/${PA_FILES[$i]}" ]; then
            pa_atomic_install "$PA_BACKUP/${PA_FILES[$i]}" "$target" || failed=1
        else
            rm -f -- "$target" || failed=1
        fi
    done
    PA_TRANSACTION=0
    [ "$failed" = 0 ] || pa_error "部分文件恢复失败，原文件备份保留在 $PA_BACKUP"
    return "$failed"
}

pa_cleanup() {
    pa_rollback || true
    # 仅清理自己通过 mktemp 创建的下载目录，不删除业务或备份目录。
    if [[ "$PA_STAGE" == "$PA_STATE"/stage.* ]] && [ -d "$PA_STAGE" ]; then
        rm -rf -- "$PA_STAGE"
    fi
    PA_STAGE=""
}

pa_install_bundle() {
    local i target parent
    for i in "${!PA_FILES[@]}"; do
        target=${PA_TARGETS[$i]}; parent=$(dirname -- "$target")
        pa_safe_directory "$parent" || return 1
        pa_known_target "$target" "${PA_FILES[$i]}" || {
            pa_error "路径已被无法识别的文件占用，已保留: $target"; return 1;
        }
    done
    PA_BACKUP=$(mktemp -d "$PA_STATE/backup.XXXXXXXX") || return 1
    for i in "${!PA_FILES[@]}"; do
        target=${PA_TARGETS[$i]}
        if [ -e "$target" ]; then cp -p -- "$target" "$PA_BACKUP/${PA_FILES[$i]}" || return 1; fi
    done
    PA_CHANGED=()
    PA_TRANSACTION=1
    for i in "${!PA_FILES[@]}"; do
        target=${PA_TARGETS[$i]}
        mkdir -p -- "$(dirname -- "$target")" || return 1
        PA_CHANGED+=("$i")
        pa_atomic_install "$PA_STAGE/${PA_FILES[$i]}" "$target" || return 1
    done
    cp -- "$PA_STAGE/commit" "$PA_STATE/commit" || return 1
    PA_TRANSACTION=0
    pa_info "脚本已配套安装。旧脚本备份: $PA_BACKUP"
    pa_info '现有节点、证书、Nginx 和 HAProxy 配置均保留。以后输入 proxyall 即可打开。'
}

pa_update() {
    local mode="${1:-ask}" i changed=0 answer
    pa_download_bundle || { pa_cleanup; return 1; }
    printf '\n  文件                   状态\n\n'
    for i in "${!PA_FILES[@]}"; do
        if [ -f "${PA_TARGETS[$i]}" ] && cmp -s "$PA_STAGE/${PA_FILES[$i]}" "${PA_TARGETS[$i]}"; then
            printf '  %-22s 已是仓库版本\n\n' "${PA_FILES[$i]}"
        else
            printf '  %-22s 待安装 / 有变化\n\n' "${PA_FILES[$i]}"
            changed=1
        fi
    done
    if [ "$changed" = 0 ]; then
        install -m 600 "$PA_STAGE/commit" "$PA_STATE/commit" || { pa_cleanup; return 1; }
        pa_cleanup
        return 0
    fi
    if [ "$mode" != install ]; then
        read -r -p '是否备份并统一更新上述脚本？[y/N]: ' answer || { pa_cleanup; return 1; }
        [[ "$answer" =~ ^[Yy]$ ]] || { pa_cleanup; return 0; }
    fi
    if ! pa_install_bundle; then pa_cleanup; return 1; fi
    pa_cleanup
    # 当前 shell 仍持有旧菜单代码，更新后重新加载，并释放会话锁。
    exec 8>&-
    exec bash "$PA_COMMAND"
}

pa_uninstall() {
    local answer
    pa_info '只卸载 proxyall 入口；保留 sb、nginxproxy、组件、备份以及全部运行服务。'
    read -r -p '输入 UNINSTALL 确认，其他输入返回: ' answer || return 1
    [ "$answer" = UNINSTALL ] || return 0
    if [ -L "$PA_COMMAND" ] || { [ -e "$PA_COMMAND" ] && ! grep -Fqx "$PA_MARKER" "$PA_COMMAND"; }; then
        pa_error '入口文件不属于 proxyall，已保留。'; return 1
    fi
    rm -f -- "$PA_COMMAND" || return 1
    pa_info 'proxyall 入口已卸载。现有服务继续运行，可用 sb / nginxproxy 管理。'
    exit 0
}

pa_run() {
    local component="$1" status=0
    [ -f "$component" ] && bash -n "$component" || { pa_error '组件缺失或语法损坏，请先检查脚本更新。'; return 1; }
    # 必须作为子进程运行，避免 deploy 的 errexit/trap/变量污染统一菜单。
    PROXYALL_MANAGED=1 bash "$component" || status=$?
    [ "$status" = 0 ] || pa_error "子脚本返回状态 $status，已返回统一菜单。"
    return 0
}

pa_menu() {
    local choice
    while true; do
        printf '\n\n  ════════════════════════════════════\n\n'
        printf '       proxyall  %s\n\n' "$PROXYALL_VERSION"
        printf '  1) Emby 反代\n\n\n'
        printf '  2) sing-box 配置（含中转 / 节点解析）\n\n\n'
        printf '  3) 检查脚本更新\n\n\n'
        printf '  4) 卸载脚本（仅统一入口，保留服务）\n\n\n'
        printf '  0) 退出脚本\n\n'
        printf '  ════════════════════════════════════\n\n'
        read -r -p '  请选择 [0-4]: ' choice || return 0
        case "$choice" in
            1) pa_run /usr/local/bin/nginxproxy ;;
            2) pa_run /usr/local/bin/sb ;;
            3) pa_update || true ;;
            4) pa_uninstall || true ;;
            0) return 0 ;;
            *) pa_error '请输入 0-4。' ;;
        esac
    done
}

main() {
    local action="${1:-}" i missing=0
    case "$action" in
        --version) printf '%s\n' "$PROXYALL_VERSION"; return 0 ;;
        -h|--help) pa_help; return 0 ;;
        ''|--install|--update|--uninstall) ;;
        *) pa_help; return 2 ;;
    esac
    [ "$EUID" = 0 ] || { pa_error '请用 root 或 sudo -H bash proxyall 运行。'; return 1; }
    [ "$(uname -s)" = Linux ] || { pa_error '此脚本用于 Linux VPS。'; return 1; }
    [ "$#" -le 1 ] || return 2
    pa_dependencies || return 1
    pa_prepare_state || return 1
    trap pa_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    case "$action" in
        --install) pa_update install || return 1; pa_menu; return $? ;;
        --update) pa_update; return $? ;;
        --uninstall) pa_uninstall; return $? ;;
    esac
    for i in "${!PA_TARGETS[@]}"; do [ -s "${PA_TARGETS[$i]}" ] || missing=1; done
    if [ ! -f "$PA_STATE/commit" ] || [ "$missing" = 1 ]; then
        pa_update install || return 1
    fi
    if [ ! -d /run/systemd/system ]; then
        pa_info '当前无 systemd：可查看已有配置；HAProxy 共享 443 功能无法部署。'
    fi
    pa_info '新建默认共享 443；已有直监听节点保持原样。Emby 域名须与 Reality SNI 不同。'
    pa_menu
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
