for _pa_lib in "${PA_LIBS[@]}"; do
    _pa_key=${_pa_lib%.sh}
    PA_FILES+=("lib/$_pa_lib")
    PA_TARGETS+=("/usr/local/lib/proxyall/$_pa_lib")
    PA_KEYS+=("${_pa_key^^}_SHA256")
